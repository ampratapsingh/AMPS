# Comma-separated adapter keys. Add discord to enable it.
ENABLED_PLATFORMS=bluesky,mastodon,devto,gist,telegram,telegraph
# Maximum time in seconds to publish to one platform.
PLATFORM_TIMEOUT_SECONDS=15

# Your Bluesky profile handle.
BLUESKY_HANDLE=your-handle.bsky.social
# Generate in Bluesky Settings > Privacy and Security > App Passwords.
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# The origin of your Mastodon instance.
MASTODON_BASE_URL=https://mastodon.social
# Create an application in Mastodon Preferences > Development with write:statuses.
MASTODON_ACCESS_TOKEN=replace-me
# Create a key in DEV Settings > Extensions.
DEVTO_API_KEY=replace-me
# Create a fine-grained GitHub token with Gists: write.
GITHUB_TOKEN=replace-me
# Create a bot with @BotFather and grant it posting permission in your channel.
TELEGRAM_BOT_TOKEN=replace-me
# The public username from your Telegram channel settings.
TELEGRAM_CHANNEL=@your-channel
# Optional. Use the access_token returned by Telegraph createAccount.
TELEGRAPH_ACCESS_TOKEN=
# Discord channel settings > Integrations > Webhooks > Copy Webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# Enable Developer Mode, then right-click the server and choose Copy Server ID.
DISCORD_GUILD_ID=replace-me
